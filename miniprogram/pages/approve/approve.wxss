.container {
  padding: 20rpx;
  background: #f5f5f5;
  min-height: 100vh;
}

.header {
  font-size: 36rpx;
  font-weight: bold;
  text-align: center;
  margin-bottom: 30rpx;
  color: #333;
}

.record-card {
  background: white;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
}

.card-header {
  display: flex;
  justify-content: space-between;
  margin-bottom: 16rpx;
  padding-bottom: 16rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.serial-no {
  font-size: 26rpx;
  color: #999;
}

.status {
  font-size: 26rpx;
  padding: 6rpx 16rpx;
  border-radius: 8rpx;
}

.status.pending {
  background: #fffbe8;
  color: #ff976a;
}

.info-row {
  display: flex;
  margin-bottom: 10rpx;
  font-size: 28rpx;
}

.label {
  color: #666;
  width: 160rpx;
}

.value {
  color: #333;
  flex: 1;
}

.vehicle-picker {
  flex: 1;
}

.picker-text {
  color: #333;
  border: 1rpx solid #d9d9d9;
  border-radius: 8rpx;
  padding: 6rpx 14rpx;
  background: #fff;
}

.card-footer {
  display: flex;
  gap: 20rpx;
  margin-top: 20rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid #f0f0f0;
}

.btn-reject {
  flex: 1;
  background: #ffebee;
  color: #f44336;
  font-size: 30rpx;
}

.btn-approve {
  flex: 1;
  background: #07c160;
  color: white;
  font-size: 30rpx;
}

.empty {
  text-align: center;
  padding: 100rpx 0;
  color: #999;
}
