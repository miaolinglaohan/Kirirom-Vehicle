<view class="container">
  <view class="header">申请详情</view>
  
  <view class="detail-card">
    <view class="row">
      <text class="label">申请编号：</text>
      <text class="value">{{detail.serialNo}}</text>
    </view>
    <view class="row">
      <text class="label">状态：</text>
      <text class="value status {{detail.status}}">{{statusText[detail.status]}}</text>
    </view>
    <view class="row">
      <text class="label">申请人：</text>
      <text class="value">{{detail.applicantName}}</text>
    </view>
    <view class="row">
      <text class="label">部门：</text>
      <text class="value">{{detail.department}}</text>
    </view>
    <view class="row">
      <text class="label">用途：</text>
      <text class="value">{{detail.purpose}}</text>
    </view>
    <view class="row">
      <text class="label">车辆：</text>
      <text class="value">{{detail.vehiclePlate}}</text>
    </view>
    <view class="row" wx:if="{{detail.driverName}}">
      <text class="label">驾驶员：</text>
      <text class="value">{{detail.driverName}}</text>
    </view>
    <view class="row">
      <text class="label">用车时间：</text>
      <text class="value">{{detail.startTime}}</text>
    </view>
    <view class="row" wx:if="{{detail.endTime}}">
      <text class="label">归还时间：</text>
      <text class="value">{{detail.endTime}}</text>
    </view>
    <view class="info-row" wx:if="{{detail.status !== 'pending'}}">
      <text class="label">审批人：</text>
      <text class="value">{{detail.approverName}}</text>
    </view>
    <view class="row" wx:if="{{detail.remark}}">
      <text class="label">备注：</text>
      <text class="value">{{detail.remark}}</text>
    </view>
  </view>

  <view class="action-section" wx:if="{{canReturn}}">
    <view class="sub-header">填写归还时间</view>
    <view class="form-item">
      <text class="label">归还日期：</text>
      <picker mode="date" bindchange="onReturnDateChange" value="{{returnDate}}">
        <view class="picker">{{returnDate || '请选择'}}</view>
      </picker>
    </view>
    <view class="form-item">
      <text class="label">归还时间：</text>
      <picker mode="time" bindchange="onReturnTimeChange" value="{{returnTime}}">
        <view class="picker">{{returnTime || '请选择'}}</view>
      </picker>
    </view>
    <button class="btn-primary" bindtap="submitReturn">确认归还</button>
  </view>
</view>
