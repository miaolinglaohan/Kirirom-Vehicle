page {
  background: #f5f5f5;
}

.container {
  padding: 30rpx;
}

.header {
  text-align: center;
  margin-bottom: 30rpx;
}

.title {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
}

.card {
  background: #fff;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 30rpx;
}

.label {
  display: block;
  font-size: 28rpx;
  color: #666;
  margin: 20rpx 0 10rpx;
}

.btn-choose {
  background: #f2f2f2;
  color: #333;
  font-size: 28rpx;
  margin-bottom: 20rpx;
}

.btn-import {
  background: #07c160;
  color: #fff;
  font-size: 30rpx;
}

.btn-import[disabled] {
  background: #ccc;
}

.result-box {
  margin-top: 30rpx;
  padding: 20rpx;
  background: #f8f8f8;
  border-radius: 12rpx;
}

.result-title {
  font-weight: bold;
  display: block;
  margin-bottom: 10rpx;
}

.success-text {
  color: #07c160;
}

.fail-text {
  color: #fa5151;
}

.tips {
  background: #fff3cd;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 30rpx;
}

.tip-title {
  font-weight: bold;
  color: #856404;
  display: block;
  margin-bottom: 10rpx;
}

.tips text {
  display: block;
  font-size: 26rpx;
  color: #856404;
  line-height: 1.8;
}

.btn-back {
  background: #fff;
  color: #666;
  border: 1rpx solid #ddd;
}