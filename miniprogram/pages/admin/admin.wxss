.openid-tip {
  background: #fffbe6;
  border: 1rpx solid #ffe58f;
  padding: 16rpx 24rpx;
  margin: 20rpx 30rpx;
  border-radius: 8rpx;
  font-size: 24rpx;
  color: #d48806;
  display: flex;
  flex-direction: column;
}

.openid-tip .tip-small {
  font-size: 22rpx;
  color: #999;
  margin-top: 8rpx;
}

.openid-tip {
  background: #fffbe6;
  border: 1rpx solid #ffe58f;
  padding: 16rpx 24rpx;
  margin: 20rpx 30rpx;
  border-radius: 8rpx;
  font-size: 24rpx;
  color: #d48806;
}

.openid-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.btn-copy {
  margin: 0;
  padding: 4rpx 20rpx;
  font-size: 22rpx;
  line-height: 1.6;
  background: #07c160;
  color: white;
  border-radius: 6rpx;
}

.openid-tip .tip-small {
  font-size: 22rpx;
  color: #999;
  margin-top: 8rpx;
  display: block;
}

.loading-tip, .no-more-tip {
  text-align: center;
  padding: 30rpx 0;
  color: #999;
  font-size: 26rpx;
}

.load-more-btn {
  text-align: center;
  padding: 24rpx 0;
  margin: 20rpx 30rpx;
  background: #f0f0f0;
  border-radius: 8rpx;
  color: #07c160;
  font-size: 28rpx;
}

.load-more-btn:active {
  background: #e0e0e0;
}
