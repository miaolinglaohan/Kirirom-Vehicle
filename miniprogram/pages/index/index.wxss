.container {
  padding: 20rpx;
  background-color: #f5f5f5;
  min-height: 100vh;
}

/* ========== 用户信息区域 ========== */
.user-bar {
  background: #07c160;
  color: white;
  padding: 30rpx;
  border-radius: 16rpx;
  margin-bottom: 20rpx;
  display: flex;
  align-items: center;
}

.user-name {
  font-size: 36rpx;
  font-weight: bold;
}

.user-role {
  font-size: 28rpx;
  margin-left: 20rpx;
  opacity: 0.9;
}

/* 未登记状态 */
.user-card.unregistered {
  background: #fffbe6;
  border: 1rpx solid #ffe58f;
  color: #d48806;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 24rpx;
  border-radius: 16rpx;
  margin-bottom: 20rpx;
}

.openid-show {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin: 12rpx 0;
  font-size: 24rpx;
  word-break: break-all;
  text-align: center;
}

.btn-copy-small {
  margin: 0;
  padding: 4rpx 16rpx;
  font-size: 22rpx;
  background: #07c160;
  color: white;
  border-radius: 6rpx;
}

.hint-text {
  font-size: 22rpx;
  color: #999;
}

/* ========== 功能按钮区域 ========== */
.action-bar {
  display: flex;
  justify-content: center;
  gap: 20rpx;
  margin-bottom: 20rpx;
}

.btn-item {
  width: 200rpx;
  height: 130rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border-radius: 16rpx;
  color: white;
}

.btn-icon {
  font-size: 48rpx;
  margin-bottom: 16rpx;
  width: 100%;
  text-align: center;
}

.btn-text {
  font-size: 26rpx;
  width: 100%;
  text-align: center;
  white-space: nowrap;
}

.btn-primary {
  background: #07c160;
}

.btn-warning {
  background: #ff976a;
}

.btn-admin {
  background: #576b95;
}

/* ========== 筛选标签 ========== */
.filter-bar {
  display: flex;
  background: white;
  padding: 20rpx;
  border-radius: 12rpx;
  margin-bottom: 20rpx;
  justify-content: space-around;
}

.filter-item {
  font-size: 28rpx;
  color: #666;
  padding: 10rpx 20rpx;
}

.filter-item.active {
  color: #07c160;
  font-weight: bold;
  border-bottom: 4rpx solid #07c160;
}

/* ========== 记录列表 ========== */
.list-container {
  padding-bottom: 40rpx;
}

.record-card {
  background: white;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.05);
}

.card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
  padding-bottom: 16rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.serial-no {
  font-size: 26rpx;
  color: #999;
}

.status {
  font-size: 26rpx;
  padding: 6rpx 16rpx;
  border-radius: 8rpx;
}

.status.pending {
  background: #fffbe8;
  color: #ff976a;
}

.status.approved {
  background: #e8f5e9;
  color: #07c160;
}

.status.rejected {
  background: #ffebee;
  color: #f44336;
}

.status.returned {
  background: #e3f2fd;
  color: #2196f3;
}

.info-row {
  display: flex;
  margin-bottom: 10rpx;
  font-size: 28rpx;
}

.label {
  color: #666;
  width: 160rpx;
  flex-shrink: 0;
}

.value {
  color: #333;
  flex: 1;
}

/* ========== 分页加载提示 ========== */
.load-more-btn {
  text-align: center;
  padding: 24rpx 0;
  margin: 20rpx 30rpx;
  background: #f0f0f0;
  border-radius: 8rpx;
  color: #07c160;
  font-size: 28rpx;
}

.load-more-btn:active {
  background: #e0e0e0;
}

.loading-tip, .no-more-tip {
  text-align: center;
  padding: 40rpx 0;
  color: #999;
  font-size: 28rpx;
}

.empty {
  text-align: center;
  padding: 100rpx 0;
  color: #999;
  font-size: 30rpx;
}